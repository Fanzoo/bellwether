{
  "name": "bellwether",
  "version": "1.0.0-rc.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Bellwether's test suite and development scripts (the app is `shell/` and `crates/`)",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build:dev": "cargo build --locked --manifest-path shell/src-tauri/Cargo.toml --features bellwether-shell/conformance",
    "pretest": "npm run build:dev",
    "test": "NODE_OPTIONS=--import=./test/setup.mjs node --test --test-concurrency=1 --test-timeout=120000 test/*.test.mjs",
    "test:cargo": "cargo test --manifest-path shell/src-tauri/Cargo.toml --workspace"
  }
}
