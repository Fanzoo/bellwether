{
  "name": "bellwether",
  "version": "0.2.0-rc.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Desktop-pet overlay for Claude Code sessions. This package is the brain: hook listener, state, doctor and hook installer.",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "serve": "node brain/cli.mjs serve",
    "record": "node brain/cli.mjs record",
    "doctor": "node brain/cli.mjs doctor",
    "hooks": "node brain/cli.mjs hooks",
    "status": "node brain/cli.mjs status",
    "replay": "node brain/cli.mjs replay",
    "test": "NODE_OPTIONS=--import=./test/setup.mjs node --test --test-concurrency=1 test/*.test.mjs",
    "test:rust": "node test/conformance.mjs",
    "test:vectors": "node --import=./test/setup.mjs test/fixtures/build-vectors.mjs --check",
    "differential": "node --import=./test/setup.mjs scripts/differential.mjs",
    "test:cargo": "cargo test --manifest-path shell/src-tauri/Cargo.toml --workspace"
  }
}
