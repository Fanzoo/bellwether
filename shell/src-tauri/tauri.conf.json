{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bellwether",
  "version": "1.0.0",
  "identifier": "local.bellwether",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["strip", "onboarding"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
