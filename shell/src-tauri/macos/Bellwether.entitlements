<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The only entitlement (distribution plan D4): click-to-focus sends Apple Events to
       iTerm2 and Terminal through /usr/bin/osascript, and under the hardened runtime
       the app, as the responsible process, needs this to be allowed to ask. No JIT, no
       sandbox, no network entitlements. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
