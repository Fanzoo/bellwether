#!/bin/sh
#
# Deprecated: the command is `bellwether` now. This shim says so once per call, on
# stderr, and forwards everything (arguments, directory, exit code) to it. It will be
# removed in a later release.

SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
echo "pasture: this command is now \`bellwether\` (same arguments); \`pasture\` will be removed in a later release." >&2
exec "$(cd "$(dirname "$SELF")" && pwd)/bellwether" "$@"
