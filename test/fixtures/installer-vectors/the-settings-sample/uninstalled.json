{
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /Users/example/.claude/sounds/what.wav"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /Users/example/.claude/sounds/ready.wav"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/example/projects/other-tool/hook.mjs",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/example/projects/other-tool/hook.mjs",
            "timeout": 1
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/example/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/example/projects/other-tool/hook.mjs",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/example/projects/other-tool/hook.mjs",
            "timeout": 1
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/example/projects/other-tool/hook.mjs",
            "timeout": 1
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "oh-my-posh claude"
  },
  "enabledPlugins": {
    "example@marketplace": true
  },
  "someFutureKey": {
    "nested": [
      1,
      2,
      {
        "x": null
      }
    ]
  },
  "theme": "dark"
}
